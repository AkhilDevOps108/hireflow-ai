# Required: local runtime
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/hireflow
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-in-production

# Required: Gemini provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_me
GEMINI_MODEL=models/gemini-3-flash-preview
GEMINI_USE_GOOGLE_SEARCH=false

# Optional: OpenAI-compatible provider (used only when LLM_PROVIDER=openai-compatible)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Optional: future integrations
EMBEDDING_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
